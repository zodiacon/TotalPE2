STRINGTABLE
BEGIN
    IDR_MAINFRAME           "Total PE"
END

STRINGTABLE
BEGIN
    ID_FILE_NEW             "Create a new windowt\nNew Window"
    ID_FILE_OPEN            "Open an existing document\nOpen"
    ID_FILE_CLOSE           "Close the active document\nClose"
    ID_FILE_SAVE            "Save the contents of the active view: a list as CSV or text, text, the bytes of a hex view, a flow graph as SVG\nSave"
