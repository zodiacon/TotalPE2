IDD_ABOUTBOX DIALOGEX 0, 0, 213, 84
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Total PE"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,81,63,50,14
    ICON            IDR_MAINFRAME,IDC_STATIC,7,7,20,20
    LTEXT           "Static",IDC_VERSION,53,10,109,8
    LTEXT           "Static",IDC_COPYRIGHT,53,23,123,8
    CONTROL         "<a>https://Github.com/zodiacon/TotalPE2</a>",IDC_LINK,
                    "SysLink",WS_TABSTOP,49,40,125,14
END

IDD_SYMBOLS DIALOGEX 0, 0, 320, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Symbol Settings"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    CONTROL         "Use a symbol &server (downloads missing PDB files)",IDC_SYM_USE_SERVER,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,200,10
    LTEXT           "Symbol server &URL:",IDC_STATIC,19,22,80,8
    EDITTEXT        IDC_SYM_SERVER_URL,19,32,294,14,ES_AUTOHSCROLL
    LTEXT           "Local &cache directory:",IDC_STATIC,19,52,80,8
    EDITTEXT        IDC_SYM_CACHE,19,62,240,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...",IDC_SYM_BROWSE,263,62,50,14
    LTEXT           "&Additional symbol paths (separate with ;):",IDC_STATIC,7,85,160,8
    EDITTEXT        IDC_SYM_EXTRA,7,95,306,14,ES_AUTOHSCROLL
    CONTROL         "Also use the _NT_SYMBOL_&PATH environment variable",IDC_SYM_USE_ENV,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,116,220,10
    LTEXT           "Resulting symbol path:",IDC_STATIC,7,132,100,8
    EDITTEXT        IDC_SYM_PREVIEW,7,142,306,40,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "&Microsoft Defaults",IDC_SYM_DEFAULTS,7,193,80,14
    DEFPUSHBUTTON   "OK",IDOK,207,193,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,263,193,50,14
END

IDD_HEXFIND DIALOGEX 0, 0, 250, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find in Hex"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "Find &what:",IDC_STATIC,7,7,60,8
    EDITTEXT        IDC_HEXFIND_TEXT,7,17,236,14,ES_AUTOHSCROLL
    GROUPBOX        "Search for",IDC_STATIC,7,38,150,60
    CONTROL         "&Hex bytes (?? matches any byte)",IDC_HEXFIND_HEX,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP,14,51,138,10
    CONTROL         "&Text (UTF-8 / ASCII)",IDC_HEXFIND_ASCII,"Button",BS_AUTORADIOBUTTON,14,64,138,10
    CONTROL         "&Unicode text (UTF-16)",IDC_HEXFIND_UNICODE,"Button",BS_AUTORADIOBUTTON,14,77,138,10
    CONTROL         "&Match case",IDC_HEXFIND_MATCHCASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,165,40,78,10
    GROUPBOX        "Direction",IDC_STATIC,165,56,78,42
    CONTROL         "&Down",IDC_HEXFIND_DOWN,"Button",BS_AUTORADIOBUTTON | WS_GROUP,172,69,60,10
    CONTROL         "&Up",IDC_HEXFIND_UP,"Button",BS_AUTORADIOBUTTON,172,82,60,10
    DEFPUSHBUTTON   "Find",IDOK,139,103,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,193,103,50,14
END

IDD_VTKEY DIALOGEX 0, 0, 260, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VirusTotal API Key"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "Scanning with VirusTotal needs an API key. The key is free: sign in on virustotal.com and copy it from your profile. It is stored encrypted for your Windows account.",IDC_STATIC,7,7,246,32
    LTEXT           "&API key:",IDC_STATIC,7,46,246,8
    EDITTEXT        IDC_VT_KEY,7,56,246,14,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "&Get a Key...",IDC_VT_GETKEY,7,97,60,14
    DEFPUSHBUTTON   "OK",IDOK,147,97,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,203,97,50,14
END

IDD_GOTO DIALOGEX 0, 0, 230, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "&Address (hexadecimal):",IDC_STATIC,7,7,150,8
    EDITTEXT        IDC_GOTO_VALUE,7,17,216,14,ES_AUTOHSCROLL
    GROUPBOX        "The address is a",IDC_STATIC,7,38,216,28
    CONTROL         "&RVA",IDC_GOTO_RVA,"Button",BS_AUTORADIOBUTTON | WS_GROUP,14,50,50,10
    CONTROL         "&VA",IDC_GOTO_VA,"Button",BS_AUTORADIOBUTTON,80,50,50,10
    CONTROL         "File &offset",IDC_GOTO_OFFSET,"Button",BS_AUTORADIOBUTTON,140,50,76,10
    CONTROL         "Show as &disassembly (code sections only)",IDC_GOTO_DISASM,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,73,216,10
    DEFPUSHBUTTON   "Go To",IDOK,117,89,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,173,89,50,14
END

IDD_SEARCH DIALOGEX 0, 0, 440, 260
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Search All"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "&Find:",IDC_STATIC,7,10,22,8
    EDITTEXT        IDC_SEARCH_TEXT,32,7,341,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "&Search",IDOK,379,6,54,16
    CONTROL         "&Imports",IDC_SEARCH_IMPORTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,27,45,10
    CONTROL         "&Exports",IDC_SEARCH_EXPORTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,57,27,45,10
    CONTROL         "S&trings",IDC_SEARCH_STRINGS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,107,27,45,10
    CONTROL         "&Resources",IDC_SEARCH_RESOURCES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,157,27,55,10
    CONTROL         "S&ymbols",IDC_SEARCH_SYMBOLS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,217,27,47,10
    CONTROL         "Se&ctions",IDC_SEARCH_SECTIONS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,269,27,47,10
    CONTROL         "Match c&ase",IDC_SEARCH_MATCHCASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,331,27,70,10
    CONTROL         "",IDC_SEARCH_RESULTS,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP,7,42,426,195
    LTEXT           "",IDC_SEARCH_STATUS,7,243,426,10
END


