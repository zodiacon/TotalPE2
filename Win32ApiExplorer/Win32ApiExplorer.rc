/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 240, 106
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Win32 API Explorer"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,95,85,50,14
    ICON            IDR_MAINFRAME,IDC_STATIC,7,7,20,20
    LTEXT           "Static",IDC_VERSION,40,10,193,8
    LTEXT           "Static",IDC_COPYRIGHT,40,22,193,8
    LTEXT           "Static",IDC_METADATA,40,38,193,18
    CONTROL         "<a href=""https://github.com/zodiacon/TotalPE2"">github.com/zodiacon/TotalPE2</a>   <a href=""https://github.com/microsoft/win32metadata"">The Win32 metadata</a>",IDC_LINK,
                    "SysLink",WS_TABSTOP,40,64,193,10
END


